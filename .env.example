# Copy this file to .env (same folder) and fill in what you have. .env is never committed to git.
# Every value is optional: without them, `py run.py pdfs` lists papers for you to download by hand.

# LibKey (Third Iron) finds full texts your library subscribes to.
# Library ID: https://libkey.io/choose-library, or ask your library. Token: ask your library or Third Iron support.
LIBKEY_LIBRARY_ID=
LIBKEY_API_TOKEN=

# Unpaywall finds legal open-access copies. It asks for your own email address so it can contact heavy users.
UNPAYWALL_EMAIL=
